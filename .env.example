# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_SCOPES=calendar:calendar:readonly,calendar:calendar

# QQ 邮箱（IMAP/SMTP）
QQ_MAIL_ADDRESS=
QQ_MAIL_AUTH_CODE=

# 大模型（境内，OpenAI 兼容格式）
# 示例：DeepSeek base_url=https://api.deepseek.com/v1 model=deepseek-chat
# 示例：通义千问 base_url=https://dashscope.aliyuncs.com/compatible-mode/v1 model=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 数据库（默认 SQLite，正式换 PostgreSQL 时修改）
DATABASE_URL=sqlite:///./office_agent.db


# 前端（登录成功后跳转地址）
FRONTEND_URL=http://localhost:5173

# 鉴权（JWT）
JWT_SECRET=dev-secret-change-me-please-32bytes-min
AUTH_REQUIRED=false
